{
    "private": true,
    "type": "module",
    "scripts": {
        "generate:wayfinder": "php artisan wayfinder:generate --with-form --ansi --no-interaction",
        "predev": "npm run generate:wayfinder",
        "dev": "vite",
        "prebuild": "npm run generate:wayfinder",
        "build": "vite build",
        "prebuild:ssr": "npm run generate:wayfinder",
        "build:ssr": "vite build && vite build --ssr",
        "pretest": "npm run generate:wayfinder",
        "test": "cross-env NODE_ENV=test vitest run",
        "pretypecheck": "npm run generate:wayfinder",
        "typecheck": "vue-tsc --noEmit --pretty false",
        "preformat": "npm run generate:wayfinder",
        "format": "prettier --write resources/",
        "preformat:check": "npm run generate:wayfinder",
        "format:check": "prettier --check resources/",
        "prelint": "npm run generate:wayfinder",
        "lint": "eslint . --fix"
    },
    "devDependencies": {
        "@eslint/js": "^9.19.0",
        "@inertiajs/vite": "^3.0.0",
        "@laravel/vite-plugin-wayfinder": "^0.1.7",
        "@tailwindcss/vite": "^4.1.11",
        "@types/node": "^22.13.5",
        "@vitejs/plugin-vue": "^6.0.0",
        "@vue/eslint-config-typescript": "^14.3.0",
        "@vue/test-utils": "^2.4.6",
        "axe-core": "^4.11.0",
        "concurrently": "^9.0.1",
        "cross-env": "^10.1.0",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-vue": "^9.32.0",
        "jsdom": "^24.1.3",
        "prettier": "^3.4.2",
        "prettier-plugin-organize-imports": "^4.1.0",
        "prettier-plugin-tailwindcss": "^0.6.11",
        "typescript": "^5.2.2",
        "typescript-eslint": "^8.23.0",
        "vite": "^7.0.4",
        "vitest": "^4.0.10",
        "vitest-axe": "^0.1.0",
        "vue-tsc": "^2.2.4"
    },
    "dependencies": {
        "@inertiajs/vue3": "^3.0.0",
        "@vueuse/core": "^12.8.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "laravel-vite-plugin": "^2.0.0",
        "lucide-vue-next": "^0.468.0",
        "reka-ui": "^2.8.0",
        "tailwind-merge": "^3.2.0",
        "tailwindcss": "^4.1.1",
        "tw-animate-css": "^1.2.5",
        "vue": "^3.5.13"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1"
    }
}
